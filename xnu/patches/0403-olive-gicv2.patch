@@ -39,6 +39,20 @@ void pe_init_fiq(void);
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 extern uint32_t sweet_vtimer_intid;
 #endif
+#if defined(ARM64_BOARD_CONFIG_OLIVE)
+/*
+ * GICv2 CPU interface and SPI helpers (pexpert/arm/pe_fiq.c, HAS_GIC_V2).
+ * Gated on the command-line board macro, not HAS_GIC_V2: sleh.c includes
+ * this header before board_config.h.
+ */
+uint32_t sweet_gic_ack(void);
+void sweet_gic_eoi(uint32_t iar);
+void sweet_gic_send_sgi(unsigned int cpu, unsigned int sgi);
+boolean_t sweet_gic_cpu_ready(unsigned int cpu);
+bool sweet_spi_attach(uint32_t intid, bool edge, void (*fn)(void *arg), void *arg);
+void sweet_spi_mask(uint32_t intid, bool masked);
+bool sweet_spi_dispatch(uint32_t intid);
+#endif
 
