diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
index f1bf592..6cab9e8 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -48,6 +48,25 @@ extern int get_preemption_level(void);
 extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
 extern void thread_deallocate(thread_t);
 extern int hz;
+
+/*
+ * OLIVE (Redmi 8, SDM439) has eMMC, not UFS, and none of the Pixel 1 / taimen
+ * hardware below: its root device is bsd/dev/olive_emmc.c (0407). sweet_ufs_init
+ * is also the driver hub (keys, touch, USB, perf, GPU, Wi-Fi), and every one of
+ * those drivers pokes MSM8996/MSM8998 addresses that on olive are either live
+ * peripherals (TLMM 0x01010000 + pin * 0x1000 is inside olive's TLMM at
+ * 0x01000000: real GPIOs) or unclaimed (the MSM8996 SPMI arbiter at 0x0400f000;
+ * olive's is at 0x0200f000, live.dts:1983). So on OLIVE the init refuses
+ * before even looking at the ADT: a /sweet-ufs node copied from the taimen ADT
+ * template must not reach the hub. A macro, not an #if around the body, so the
+ * rest still compiles on OLIVE without -Wunreachable-code / -Wunused-function.
+ */
+#if defined(ARM64_BOARD_CONFIG_OLIVE)
+#define SWEET_UFS_HUB_BLOCKED   1
+#else
+#define SWEET_UFS_HUB_BLOCKED   0
+#endif
+
 static void sweet_log_start(void);
 extern void sweet_sample_start(void);
 extern void sweet_keys_init(void);
@@ -681,6 +700,11 @@ sweet_ufs_init(void)
 	char want[64] = "userdata";
 	int error;
 
+	if (SWEET_UFS_HUB_BLOCKED) {
+		/* OLIVE: no UFS host, and the Pixel 1 / taimen drivers must never start */
+		printf("SWEET UFS: olive: no UFS, Pixel 1/taimen driver hub blocked\n");
+		return ENXIO;
+	}
 	if (SecureDTLookupEntry(NULL, "/sweet-ufs", &node) != kSuccess ||
 	    SecureDTGetProperty(node, "reg", (void const **)&reg, &size) != kSuccess ||
 	    size < 2 * sizeof(uintptr_t)) {
@@ -773,6 +797,12 @@ sweet_ufs_init(void)
 	taimen_sensors_init();
 	/* USB: the state probe; with sweetusb=2 USB Ethernet to the PC (0297, sweet_usb.c) */
 	sweet_usb_probe();
+#elif defined(ARM64_BOARD_CONFIG_OLIVE)
+	/*
+	 * Unreachable (SWEET_UFS_HUB_BLOCKED above), and empty on purpose: none of
+	 * the Pixel 1 / taimen drivers is retargeted to SDM439. The olive board hook
+	 * is olive_board_start() from the eMMC root path (0407).
+	 */
 #else
 	sweet_keys_init();
 	sweet_touch_init();
