+#define PRZ_DATA_MAX    (SWEET_EARLY_LOG_PRZ_SIZE - 12u)
+_Static_assert(PRZ_OFF + 12u + PRZ_DATA_MAX <= 0x200000u, "PRZ must fit in the 2 MB early log block");
+#elif defined(TAIMEN)
