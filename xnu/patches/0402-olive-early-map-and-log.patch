+#elif defined(OLIVE)
+/*
+ * Stage marks also go on the screen: LK leaves the video-mode panel scanning
+ * out of its splash framebuffer (probe v2), so a band shows up without any
+ * kick. RGB888, bytes 0/1/2 = R/G/B, 720 px = exactly the 2160-byte row.
+ * The framebuffer is Device memory: only aligned 32-bit stores, three words
+ * (four pixels) per pattern repeat. Before arm_vm_init it is V=P through the
+ * bootstrap tables (start.s); after sweet_early_relocate it is an alias next
+ * to the log zone (arm_vm_init.c), as is PS_HOLD.
+ */
+_Static_assert(OLIVE_FB_W * 3u == OLIVE_FB_STRIDE && OLIVE_FB_STRIDE % 12u == 0u, "olive band writer assumes packed 3 B/px rows");
+static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)OLIVE_FB_PA;
+/* PS_HOLD for an early reset (0405): no V=P mapping, so NULL until relocated. */
+volatile uint32_t *olive_early_pshold;
+
+static void
+sweet_early_band(unsigned int stage)
+{
+	unsigned int y0 = 1000u + 8u * (stage % 60u);
+	/* red, green, blue by stage % 3, paler on odd stages: never black on the black splash */
+	uint32_t rgb = (0xff0000u >> ((stage % 3u) * 8u)) | ((stage & 1u) ? 0x404040u : 0u);
+	uint8_t px[12];
+	for (unsigned int i = 0; i < 12u; i += 3u) {
+		px[i] = (uint8_t)(rgb >> 16);
+		px[i + 1u] = (uint8_t)(rgb >> 8);
+		px[i + 2u] = (uint8_t)rgb;
+	}
+	uint32_t w[3];
+	for (unsigned int i = 0; i < 3u; i++) {
+		w[i] = (uint32_t)px[4u * i] | ((uint32_t)px[4u * i + 1u] << 8) |
+		    ((uint32_t)px[4u * i + 2u] << 16) | ((uint32_t)px[4u * i + 3u] << 24);
+	}
+	for (unsigned int y = y0; y < y0 + 6u && y < OLIVE_FB_H; y++) {
+		volatile uint32_t *row = early_fb + (y * OLIVE_FB_STRIDE) / 4u;
+		for (unsigned int x = 0; x < OLIVE_FB_STRIDE / 4u; x += 3u) {
+			row[x] = w[0];
+			row[x + 1u] = w[1];
+			row[x + 2u] = w[2];
+		}
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
