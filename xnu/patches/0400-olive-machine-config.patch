diff --git a/pexpert/pexpert/arm64/OLIVE.h b/pexpert/pexpert/arm64/OLIVE.h
new file mode 100644
index 0000000..e5fb5a1
--- /dev/null
+++ b/pexpert/pexpert/arm64/OLIVE.h
@@ -0,0 +1,86 @@
+/*
+ * Board config for the Redmi 8 ("olive", Qualcomm SDM439 / Snapdragon 439):
+ * eight Cortex-A53 (two clusters of four, MPIDR 0x000-0x003 and 0x100-0x103),
+ * ARMv8.0, no PAC, no LSE, no PAN. ID_AA64MMFR0_EL1 = 0x1122: only the 4K and
+ * 64K translation granules, so like taimen this is the SWEET board without
+ * 16K pages. Included from board_config.h right after SWEET.h and layered on
+ * it with #undef/#define. ARM64_BOARD_CONFIG_TAIMEN is NOT defined: taimen's
+ * early-boot addresses are inside olive's xnu RAM (0xa0000000-).
+ *
+ * Interrupts: GICv2 (QGIC2: GICD 0x0b000000, GICC 0x0b002000, TYPER 0x4ea)
+ * with security extensions. Everything we own is Group 1 non-secure and
+ * arrives as an IRQ through the memory-mapped CPU interface; there are no
+ * ICC_* system registers.
+ */
+
+#ifndef _PEXPERT_ARM64_OLIVE_H
+#define _PEXPERT_ARM64_OLIVE_H
+
+#define OLIVE                     1
+
+/* 4K pages: the CPU has no 16K granule. */
+#undef __ARM_16K_PG__
+
+/* GICv2, not the GICv3 of SWEET.h (pe_fiq.c, sleh.c, SweetCPU.cpp). */
+#undef HAS_GIC_V3
+#define HAS_GIC_V2                1
+
+/*
+ * DT timer node <1 2>, <1 3>, <1 4>, <1 1>: secure phys PPI 2, non-secure
+ * phys PPI 3, virtual PPI 4, hyp PPI 1. The virtual timer xnu uses (CNTV)
+ * is INTID 16 + 4 = 20 (29 IRQs per 300 ms, probe v1).
+ */
+#undef SWEET_VTIMER_INTID
+#define SWEET_VTIMER_INTID        20
+
+/*
+ * The shim enters xnu on the first core of the second cluster; MPIDR 0x000
+ * is logical cpu 4 in the ADT.
+ */
+#define OLIVE_BOOT_MPIDR          0x100
+
+/*
+ * Early boot log (osfmk/arm64/sweet_early.c): the olive ramoops region
+ * (1 MiB at 0x9ff00000, console zone 0x80000 at its start) and the 2 MiB
+ * block the 4K early code maps around it. Both are below xnu RAM.
+ */
+#undef SWEET_EARLY_LOG_BLOCK
+#undef SWEET_EARLY_LOG_PRZ
+#define SWEET_EARLY_LOG_BLOCK     0x9fe00000
+#define SWEET_EARLY_LOG_PRZ       0x9ff00000
+#define SWEET_EARLY_LOG_PRZ_SIZE  0x80000
+
+/*
+ * Early screen: LK leaves MDP/DSI scanning out of the continuous-splash
+ * region (20 MiB at 0x90000000 = ten 2 MiB blocks), RGB888 at 0x90001000,
+ * 720x1520, 2160 bytes per row. PS_HOLD (DT restart@4ab000) for an early reset.
+ */
+#define OLIVE_SPLASH_PA           0x90000000
+#define OLIVE_SPLASH_BLOCKS       10
+#define OLIVE_FB_PA               0x90001000
+#define OLIVE_FB_W                720
+#define OLIVE_FB_H                1520
+#define OLIVE_FB_STRIDE           2160
+#define OLIVE_PSHOLD_PA           0x004ab000
+
+/*
+ * GICv2 register definitions; see GICv2 spec (Arm IHI 0048B). GICD_CTLR and
+ * GICD_CTLR_ENABLEGRP1 come from SWEET.h with the same values (non-secure
+ * view: bit 0 enables Group 1); the indexed GICD registers are defined next
+ * to their users in pe_fiq.c.
+ */
+#define GICD_TYPER                0x004
+#define GICD_SGIR                 0xf00
+
+#define GICD_SGIR_TARGET_SHIFT    16
+
+#define GICC_CTLR                 0x000
+#define GICC_PMR                  0x004
+#define GICC_BPR                  0x008
+#define GICC_IAR                  0x00c
+#define GICC_EOIR                 0x010
+
+#define GICC_IAR_INTID_MASK       0x3ff
+/* End of GICv2 register definitions */
+
+#endif /* ! _PEXPERT_ARM64_OLIVE_H */
